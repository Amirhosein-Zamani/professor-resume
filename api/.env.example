NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/professor_resume

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_ACCESS_NAME=atkn
COOKIE_REFRESH_NAME=rtkn
COOKIE_SECURE=false

# Optional. If omitted, JWT_SECRET is used for OTP hashing.
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_EMAIL_MAX=3
OTP_RATE_LIMIT_IP_MAX=10
OTP_VERIFY_RATE_LIMIT_EMAIL_MAX=5
OTP_VERIFY_RATE_LIMIT_IP_MAX=20
GOLESTAN_RATE_LIMIT_WINDOW_SECONDS=300
GOLESTAN_RATE_LIMIT_MAX=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-account@example.com

GOLESTAN_BASE_URL=
GOLESTAN_LOGIN=
GOLESTAN_PASS=
GOLESTAN_SEC=
