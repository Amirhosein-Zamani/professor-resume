model Publication {
  id                        String     @id @default(uuid())
  golestanArticleNo         String?    @unique
  printPlace                String?
  language                  String?
  journalArticleType        String?
  latinJournalOrConfTitle   String?
  persianJournalOrConfTitle String?
  activityRegisteredAt      DateTime?
  professorId               String?
  rawData                   Json?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  title                     String?
  journal                   String?
  year                      Int?
  authors                   String?
  doi                       String?
  professor                 Professor? @relation(fields: [professorId], references: [id])

  @@map("publications")
}
