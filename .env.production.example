# Compose and published ports
COMPOSE_PROJECT_NAME=professor-resume
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
API_BIND_ADDRESS=0.0.0.0
API_PORT=4000

# PostgreSQL (POSTGRES_PASSWORD is generated by install.sh when left unchanged)
POSTGRES_DB=professor_resume
POSTGRES_USER=professor_resume
POSTGRES_PASSWORD=CHANGE_ME_GENERATED

# Public browser URLs. Replace SERVER_IP before installation.
WEB_ORIGIN=http://SERVER_IP:3000
NEXT_PUBLIC_API_URL=http://SERVER_IP:4000/api
NEXT_PUBLIC_SITE_URL=http://SERVER_IP:3000

# Authentication (secrets are generated by install.sh when left unchanged)
JWT_SECRET=CHANGE_ME_GENERATED
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_ACCESS_NAME=atkn
COOKIE_REFRESH_NAME=rtkn
# false is required for initial plain-HTTP/IP testing; use true with HTTPS.
COOKIE_SECURE=false
OTP_HASH_SECRET=CHANGE_ME_GENERATED
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_EMAIL_MAX=3
OTP_RATE_LIMIT_IP_MAX=10
OTP_VERIFY_RATE_LIMIT_EMAIL_MAX=5
OTP_VERIFY_RATE_LIMIT_IP_MAX=20

# Initial data: auto seeds only when the users table is empty.
SEED_MODE=auto
SEED_ADMIN_EMAIL=admin@example.com
SEED_SECONDARY_ADMIN_EMAIL=
SEED_AUTHOR_EMAIL=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME@example.com

# Optional Golestan integration; leave empty when unavailable.
GOLESTAN_BASE_URL=
GOLESTAN_LOGIN=
GOLESTAN_PASS=
GOLESTAN_SEC=
GOLESTAN_RATE_LIMIT_WINDOW_SECONDS=300
GOLESTAN_RATE_LIMIT_MAX=5
